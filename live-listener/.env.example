# Kopiere diese Datei nach .env (die .env wird NICHT committet).
# Alles ist optional – ohne .env läuft der Listener mit den Standardwerten.

# TikTok-Benutzername, der gelesen wird (ohne @)
TIKTOK_USER=bennys.town

# Lokale Ports
WS_PORT=21213
STATUS_PORT=21214

# Welche Bibliothek: piratetok (Standard, ohne fremden Dienst) oder connector (Reserve, über Euler Stream).
# Leer lassen = piratetok, bei 3 Fehlern in Folge automatisch Wechsel auf connector.
# ENGINE=piratetok

# Optional, nur für ENGINE=connector: Euler-Stream-API-Key (kostenloses Konto auf eulerstream.com).
# Nur nötig, wenn das anonyme Gratis-Limit des Signatur-Dienstes nicht reicht.
# Das ist KEIN TikTok-Login – es ist nur ein Schlüssel für den Signatur-Dienst.
# EULER_API_KEY=

# Wie oft (Sekunden) geprüft wird, ob du live bist, solange du offline bist (min. 30)
OFFLINE_CHECK_SECONDS=30
